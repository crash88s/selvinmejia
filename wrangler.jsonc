{
	// selvinmejia.com en Cloudflare Workers (mismo esquema que aves y PacketLens).
	//   Probar en tu Mac:  bash publicar.sh --local   → http://localhost:8787
	//   Publicar:          bash publicar.sh
	"name": "selvinmejia",
	"main": "src/index.js",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": ".", // la raíz del repo; lo que no es sitio está en .assetsignore
		"binding": "ASSETS",
		"run_worker_first": true // para /api/estado, la redirección de www y las cabeceras de seguridad
	},
	"workers_dev": false,
	"routes": [
		{ "pattern": "selvinmejia.com", "custom_domain": true },
		{ "pattern": "www.selvinmejia.com", "custom_domain": true }
	],
	"observability": { "enabled": true },
		// Límite de eventos por persona (para que nadie llene los conteos con un script)
	"ratelimits": [
		{ "name": "LIMITE_EVENTOS", "namespace_id": "4291", "simple": { "limit": 60, "period": 60 } }
	],
	"d1_databases": [
		// Base propia del sitio: conteos anónimos y donaciones del panel (/panel).
		// publicar.sh la crea la primera vez y escribe aquí su database_id.
		{
			"binding": "DATOS",
			"database_name": "selvinmejia-datos",
			"database_id": "3b649232-9954-48ad-9ba8-72b514f6d613"
		},
		// Conteos de PacketLens (su base D1, que conserva el nombre tshoot-datos). Aquí solo se LEEN.
		// "remote": true hace que la vista local también lea los datos reales de Cloudflare.
		{
			"binding": "DB",
			"database_name": "tshoot-datos",
			"database_id": "816a4172-cc52-4a8b-878f-a5e54fb819a9",
			"remote": true
		}
	]
}
